---
export interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Morgan Pfaff — Bioengineer, PhD candidate at UC Berkeley/UCSF, working on hydrogel-based tissue regeneration.",
} = Astro.props;

const nav = [
  { href: "/", label: "Home" },
  { href: "/about/", label: "About" },
  { href: "/projects/", label: "Projects" },
  { href: "/publications/", label: "Publications" },
  { href: "/community/", label: "Community" },
  { href: "/contact/", label: "Contact" },
];

const currentPath = Astro.url.pathname;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialImageURL = new URL("/social-preview.jpg", Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title} · Morgan Pfaff</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🌸</text></svg>" />
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={`${title} · Morgan Pfaff`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} · Morgan Pfaff`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageURL} />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap header-inner">
        <a class="brand" href="/">Morgan Pfaff</a>
        <nav aria-label="Primary">
          <ul>
            {nav.map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-current={currentPath === item.href ? "page" : undefined}
                >
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>
    </header>

    <main class="wrap page">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap footer-inner">
        <p>&copy; {new Date().getFullYear()} Morgan Pfaff</p>
        <p class="footer-links">
          <a href="mailto:morgan.pfaff1@gmail.com">Email</a>
          <span aria-hidden="true">·</span>
          <a href="https://www.linkedin.com/in/morgan-pfaff/" target="_blank" rel="noopener noreferrer">LinkedIn</a>
        </p>
      </div>
    </footer>

    <style is:global>
      :root {
        --pink-50: #fff0f6;
        --pink-100: #ffdceb;
        --pink-200: #ffb8d6;
        --pink-300: #ff8fbd;
        --pink-400: #f966a3;
        --pink-500: #ec4899;
        --pink-600: #d43b82;
        --pink-700: #a52c64;
        --ink: #2b2230;
        --ink-soft: #5c4f59;
        --paper: #fffafc;
        --line: #ffd6e8;
        --max-width: 780px;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      }

      * {
        box-sizing: border-box;
      }

      html,
      body {
        margin: 0;
        padding: 0;
      }

      body {
        background: var(--paper);
        color: var(--ink);
        line-height: 1.65;
        -webkit-font-smoothing: antialiased;
      }

      .wrap {
        max-width: var(--max-width);
        margin: 0 auto;
        padding: 0 1.5rem;
      }

      a {
        color: var(--pink-600);
        text-decoration: none;
      }

      a:hover {
        text-decoration: underline;
      }

      .site-header {
        border-bottom: 1px solid var(--line);
        background: var(--pink-50);
      }

      .header-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 0.75rem;
        padding-top: 1.1rem;
        padding-bottom: 1.1rem;
      }

      .brand {
        font-weight: 700;
        font-size: 1.15rem;
        color: var(--ink);
      }

      .brand:hover {
        text-decoration: none;
        color: var(--pink-600);
      }

      nav ul {
        list-style: none;
        display: flex;
        gap: 1.5rem;
        margin: 0;
        padding: 0;
      }

      nav a {
        color: var(--ink-soft);
        font-weight: 500;
        padding-bottom: 2px;
        border-bottom: 2px solid transparent;
      }

      nav a:hover {
        text-decoration: none;
        color: var(--pink-600);
      }

      nav a[aria-current="page"] {
        color: var(--pink-600);
        border-bottom-color: var(--pink-400);
      }

      .page {
        padding-top: 3rem;
        padding-bottom: 4rem;
        min-height: 60vh;
      }

      h1,
      h2,
      h3 {
        line-height: 1.25;
        color: var(--ink);
      }

      h1 {
        font-size: 2.1rem;
        margin-bottom: 0.5rem;
      }

      h2 {
        font-size: 1.4rem;
        margin-top: 2.5rem;
        color: var(--pink-700);
      }

      p {
        margin: 1rem 0;
        color: var(--ink-soft);
      }

      .tagline {
        font-size: 1.2rem;
        color: var(--pink-600);
        font-weight: 600;
        margin-top: 0;
      }

      .pill {
        display: inline-block;
        background: var(--pink-100);
        color: var(--pink-700);
        border-radius: 999px;
        padding: 0.25rem 0.85rem;
        font-size: 0.85rem;
        font-weight: 600;
        margin-bottom: 1rem;
      }

      .btn {
        display: inline-block;
        background: var(--pink-500);
        color: white;
        padding: 0.65rem 1.4rem;
        border-radius: 999px;
        font-weight: 600;
        margin-top: 0.5rem;
      }

      .btn:hover {
        background: var(--pink-600);
        text-decoration: none;
      }

      .btn.secondary {
        background: transparent;
        color: var(--pink-600);
        border: 2px solid var(--pink-300);
      }

      .btn.secondary:hover {
        background: var(--pink-50);
      }

      .card {
        border: 1px solid var(--line);
        background: white;
        border-radius: 16px;
        padding: 1.75rem;
        margin: 1.5rem 0;
      }

      .card h3 {
        margin-top: 0;
        color: var(--pink-700);
      }

      .home-cta {
        display: flex;
        gap: 0.85rem;
        flex-wrap: wrap;
        margin-top: 1.5rem;
      }

      .site-footer {
        border-top: 1px solid var(--line);
        background: var(--pink-50);
      }

      .footer-inner {
        display: flex;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 0.5rem;
        padding: 1.5rem;
        font-size: 0.9rem;
        color: var(--ink-soft);
      }

      .footer-links a {
        color: var(--ink-soft);
        font-weight: 500;
      }

      .footer-links a:hover {
        color: var(--pink-600);
      }

      em {
        color: var(--pink-600);
        font-style: italic;
      }

      .pub-list {
        list-style: none;
        margin: 1rem 0 2rem;
        padding: 0;
      }

      .pub-item {
        padding: 0.9rem 0;
        border-bottom: 1px solid var(--line);
      }

      .pub-item:last-child {
        border-bottom: none;
      }

      .pub-item p {
        margin: 0.2rem 0 0;
      }

      .pub-title {
        color: var(--ink);
        font-weight: 600;
      }

      .pub-meta {
        color: var(--pink-600);
        font-size: 0.9rem;
        font-weight: 600;
      }

      .pub-note {
        color: var(--ink-soft);
        font-size: 0.85rem;
        font-style: italic;
      }

      .card-img {
        width: 100%;
        border-radius: 12px;
        display: block;
        margin-bottom: 0.75rem;
      }

      .photo-credit {
        color: var(--ink-soft);
        font-size: 0.78rem;
        margin-top: -0.5rem;
      }

      .home-photo {
        margin-top: 2.5rem;
      }
    </style>
  </body>
</html>
